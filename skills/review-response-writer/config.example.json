{
  "_comment": "Example config for The E-Commerce Seller plugin. This file lives at <plugin-root>/.config/the-ecommerce-seller.config.json after onboarding. Shared across all skills in the plugin. The review_response section is added by the Review Response Writer (skill #10).",
  "version": 1,
  "store": {
    "brand_name": "",
    "tagline": "",
    "website_url": "",
    "primary_category": ""
  },
  "platforms_enabled": {
    "shopify": true,
    "amazon": false,
    "etsy": false,
    "ebay": false,
    "walmart": false,
    "tiktok_shop": false
  },
  "brand_voice": {
    "archetype": "",
    "tone": "",
    "vocabulary_use": [],
    "vocabulary_avoid": [],
    "voice_examples": [],
    "signer_names": [],
    "captured_via": "questionnaire",
    "last_updated": ""
  },
  "audience": {
    "description": "",
    "pain_points": [],
    "aspirations": []
  },
  "output_preferences": {
    "output_folder": "",
    "filename_pattern": "{product_name}_descriptions_{date}",
    "include_character_counts": true,
    "variants_per_platform": 2
  },
  "review_response": {
    "_comment": "Settings specific to the Review Response Writer (skill #10).",
    "platforms_active": {
      "shopify_judge_me": true,
      "shopify_loox": false,
      "shopify_yotpo": false,
      "shopify_stamped": false,
      "shopify_reviews_io": false,
      "amazon": false,
      "etsy": false,
      "google": false,
      "trustpilot": false,
      "facebook": false
    },
    "default_signer_first_name": "",
    "founder_first_name": "",
    "founder_signs_when": {
      "star_rating_at_most": 1,
      "high_ltv_customers": true,
      "trustpilot_or_google": true,
      "high_visibility_complaint": true
    },
    "offline_handoff_channels": {
      "primary_email": "",
      "instagram_dm_handle": "",
      "messenger_enabled": true
    },
    "platform_voice_override": {
      "amazon": "professional, neutral, slightly more formal than the base brand voice",
      "trustpilot": "polished, brand-aware",
      "google": "polished, SEO-aware, includes product/brand naturally"
    },
    "testimonial_mining": {
      "enabled": true,
      "min_quote_words": 8,
      "max_quote_words": 30,
      "min_score_to_cache": 60,
      "default_use_cases": ["landing_page_testimonial", "amazon_a_plus_module", "ad_creative_testimonial"]
    },
    "objection_mining": {
      "enabled": true,
      "min_strength_to_cache": 50,
      "auto_flag_systemic_at": 4
    },
    "keyword_enrichment": {
      "enabled": true,
      "min_occurrences_to_promote": 3
    },
    "dispute_workflow": {
      "auto_draft_for_flagged_fake": true,
      "auto_draft_for_abusive": false,
      "max_disputes_per_month": 5
    }
  },
  "connectors_known": {
    "shopify": "unknown",
    "klaviyo": "unknown",
    "meta_ads": "unknown",
    "canva": "unknown",
    "amazon": "unknown",
    "gmail": "unknown",
    "trustpilot": "unknown"
  },
  "api_keys": {
    "fal_ai": ""
  }
}
